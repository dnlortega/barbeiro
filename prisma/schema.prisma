generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Salon: entidade principal autenticada ──────────────────────────────────
model Salon {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  email        String        @unique
  password     String
  whatsapp     String?
  address      String?
  darkMode     Boolean       @default(true)
  isAdmin      Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  barbers      Barber[]
  services     Service[]
  appointments Appointment[]
  waitList     WaitList[]
  closedDates  ClosedDate[]
}

// ── Barber: profissional vinculado a um salão (sem login) ──────────────────
model Barber {
  id           String        @id @default(cuid())
  salonId      String
  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name         String
  email        String?
  image        String?
  startTime    String?       @default("09:00")
  endTime      String?       @default("19:00")
  createdAt    DateTime      @default(now())
  services     Service[]     @relation("BarberServices")
  appointments Appointment[]
  waitList     WaitList[]    @relation("WaitListBarber")
}

// ── Service ────────────────────────────────────────────────────────────────
model Service {
  id           String        @id @default(cuid())
  salonId      String
  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name         String
  price        Float
  duration     Int
  isCombo      Boolean       @default(false)
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  barbers      Barber[]      @relation("BarberServices")
  appointments Appointment[]
  waitList     WaitList[]    @relation("WaitListService")
}

// ── Appointment ────────────────────────────────────────────────────────────
model Appointment {
  id            String   @id @default(cuid())
  salonId       String
  salon         Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barberId      String
  barber        Barber   @relation(fields: [barberId], references: [id])
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id])
  customerName  String?
  customerPhone String?
  date          DateTime
  status        String   @default("PENDING")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── WaitList ───────────────────────────────────────────────────────────────
model WaitList {
  id            String    @id @default(cuid())
  salonId       String
  salon         Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String
  barberId      String?
  barber        Barber?   @relation("WaitListBarber", fields: [barberId], references: [id])
  serviceId     String
  service       Service   @relation("WaitListService", fields: [serviceId], references: [id])
  preferredDate DateTime?
  notes         String?
  status        String    @default("WAITING")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ── ClosedDate ─────────────────────────────────────────────────────────────
model ClosedDate {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())
}
